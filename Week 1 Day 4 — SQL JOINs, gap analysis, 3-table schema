select c.customer_name , sum(oi.sales) as total_sales from customers as c
inner join orders as o on c.customer_id = o.customer_id
inner join order_items as oi on oi.order_id=o.order_id
where o.region ='West'
group by c.customer_id
order by total_sales desc
limit 10



select oi.category , round((sum(oi.profit)/count(o.order_id)),2) as profit_PO from order_items as oi
inner join orders as o on o.order_id = oi.order_id 
where o.region ='East'
group by oi.category 
order by profit_po  desc 

